{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Account Jotter",
  "version": "2.0.0-rc.4",
  "identifier": "com.szgenle.accountjotter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "账号小本本 · Account Jotter",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["ajot"],
        "name": "Account Jotter Vault",
        "description": "账号小本本加密账号库（v7：SM4-GCM + Argon2id）",
        "role": "Editor",
        "mimeType": "application/x-account-jotter"
      }
    ]
  }
}
